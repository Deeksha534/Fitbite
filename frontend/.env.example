# FitBite Frontend Environment Variables Example
# IMPORTANT: Never place sensitive server secrets (like service role keys) here.
# All VITE_* variables are exposed to the browser client bundle.

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Supabase Public Configuration (Client-side only)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key
