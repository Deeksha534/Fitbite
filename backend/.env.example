# FitBite Backend Environment Variables (Standard Node.js / Express + PostgreSQL)
# IMPORTANT: This is a configuration template. Never commit real production secrets to git.

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitbite_db

# Authentication / JWT Configuration
JWT_SECRET=your_jwt_super_secret_key_min_32_characters_long
JWT_EXPIRES_IN=7d
